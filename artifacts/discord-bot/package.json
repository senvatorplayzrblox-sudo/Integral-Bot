{
  "name": "@workspace/discord-bot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --watch src/index.ts",
    "start": "tsx src/index.ts",
    "deploy": "tsx src/deploy-commands.ts",
    "test": "node --experimental-test-module-mocks --import tsx --test src/db/models/*.test.ts src/lib/*.test.ts src/events/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@discordjs/rest": "^2.5.0",
    "discord.js": "^14.21.0",
    "mongoose": "^9.7.0",
    "pino": "^9.14.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  }
}
